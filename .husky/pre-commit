# Node 24 via nvm when available. A missing nvm install keeps the Node already on PATH.
export NVM_DIR="${NVM_DIR:-$HOME/.nvm}"
if [ -s "$NVM_DIR/nvm.sh" ]; then
	. "$NVM_DIR/nvm.sh" >/dev/null 2>&1 && nvm use >/dev/null 2>&1 || true
fi

# Wrong Node major (.nvmrc): fail loudly with the fix, before pnpm crashes cryptically.
node scripts/node-guard.mjs || exit 1

pnpm exec lint-staged --quiet

# One gate. On failure, print a short excerpt and the full log path.
VERIFY_LOG="${TMPDIR:-/tmp}/axc-verify-$(basename "$PWD").log"
SUMMARY="${TMPDIR:-/tmp}/axc-verify-summary-$(basename "$PWD").txt"
rm -f "$SUMMARY"
if ! pnpm run verify >"$VERIFY_LOG" 2>&1; then
	# excerpt exits 0 when it finds no known failure pattern, so fall back to the tail
	node scripts/verify-excerpt.mjs "$VERIFY_LOG" && tail -n 30 "$VERIFY_LOG"
	echo "verify FAILED — full log: $VERIFY_LOG"
	exit 1
fi
node scripts/verify-summary.mjs "$VERIFY_LOG" >"$SUMMARY" 2>/dev/null || echo "verify ok" >"$SUMMARY"
# Completion marker: a commit whose log lacks this line did not finish verify.
cat "$SUMMARY" >>"$VERIFY_LOG"
